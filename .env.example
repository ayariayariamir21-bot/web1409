# Digital Store — example environment. Copy to `.env` for local development.
# NEVER commit real secrets. Placeholders below are non-sensitive examples.
# See docs/configuration.md for the full reference.

# --- Server runtime ---
# development | test | production (default: development)
NODE_ENV=development
# TCP port (default: 3000)
PORT=3000

# --- Future use (documented now, not connected yet) ---
# Postgres connection string. Optional until the database prompt lands.
# DATABASE_URL=postgresql://user:password@localhost:5432/web1409
# Opaque-session secret. REQUIRED in production (32+ random characters).
# In development/test the server uses a documented insecure fallback instead.
# Leave empty locally; fill with a generated random value in production.
SESSION_SECRET=

# --- Pre-existing dev storage proxy (unchanged behavior) ---
# Only used by the Vite dev middleware in vite.config.ts. Leave empty if unused.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Public browser variables (VITE_* is embedded in the client bundle) ---
# Never put secrets, DATABASE_URL or SESSION_SECRET behind a VITE_ name.
VITE_OAUTH_PORTAL_URL=https://oauth-portal.example.com
VITE_APP_ID=demo-app-id
